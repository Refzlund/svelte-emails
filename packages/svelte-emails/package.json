{
	"name": "svelte-emails",
	"version": "0.0.15",
	"description": "Email template library for Svelte with a development server",
	"type": "module",
	"bin": {
		"svelte-emails": "./cli/bin/svelte-emails.js"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"cli",
		"LLM.md",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist && bun scripts/fix-esm-imports.ts"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"shiki": {
			"optional": true
		}
	},
	"dependencies": {
		"morphdom": "^2.7.7",
		"fast-glob": "^3.3.3",
		"chokidar": "^4.0.3",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"vite": "^7.2.2",
		"floating-runes": "^1.3.1"
	},
	"optionalDependencies": {
		"shiki": "^3.19.0",
		"@shikijs/langs": "^3.19.0",
		"@shikijs/themes": "^3.19.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/package": "^2.3.11",
		"@types/morphdom": "^2.4.2",
		"@types/node": "^22.15.29",
		"svelte": "catalog:",
		"typescript": "catalog:"
	},
	"keywords": [
		"svelte",
		"email",
		"templates",
		"mjml",
		"newsletter"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Refzlund/svelte-emails"
	},
	"license": "MIT",
	"author": "Refzlund"
}