{
	"name": "svelte-emails-repository",
	"bin": {
		"svelte-emails": "./run-emails.ts"
	},
	"scripts": {
		"dev": "bun run packages/cli/src/cli.ts --dev",
		"build": "bun run scripts/build.ts",
		"changeset": "changeset",
		"version": "changeset version",
		"publish": "bun run build && cd packages/svelte-emails && npm publish"
	},
	"workspaces": {
		"packages": [
			"packages/*",
			"emails"
		],
		"catalog": {
			"@sveltejs/kit": "^2.48.5",
			"@sveltejs/vite-plugin-svelte": "^6.2.1",
			"svelte": "^5.43.8",
			"typescript": "^5.9.3",
			"vite": "^7.2.2"
		}
	},
	"devDependencies": {
		"@changesets/cli": "^2.28.1",
		"@types/bun": "^1.3.3",
		"rolldown": "^1.0.0-beta.52",
		"shiki": "^3.19.0",
		"svelte-emails": "workspace:*"
	}
}