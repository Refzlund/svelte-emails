{
	"name": "svelte-emails-repository",
	"bin": {
		"svelte-emails": "./run-emails.ts"
	},
	"scripts": {
		"dev": "cd apps/dev && bun run dev",
		"emails": "bun run run-emails.ts",
		"build": "bun run scripts/build.ts",
		"link": "cd _dist && bun link && cd ..",
		"unlink": "cd _dist && bun unlink && cd .."
	},
	"workspaces": {
		"packages": [
			"packages/*",
			"emails"
		],
		"catalog": {
			"@sveltejs/kit": "^2.48.5",
			"@sveltejs/vite-plugin-svelte": "^6.2.1",
			"svelte": "^5.43.8",
			"typescript": "^5.9.3",
			"vite": "^7.2.2"
		}
	},
	"devDependencies": {
		"rolldown": "^1.0.0-beta.52"
	}
}